# Copy this to .env and fill it in. run.sh loads it automatically.

# --- Brain (required to talk to Sunny) ---
# Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...
# Optional overrides:
# SUNNY_MODEL=claude-opus-4-8
# SUNNY_EFFORT=high

# --- Phone bridge (ntfy) ---
# Install the ntfy app, then SUBSCRIBE to NTFY_TOPIC to receive Sunny's messages,
# and SEND messages to NTFY_INBOUND_TOPIC to talk to her.
# Pick long, unguessable names — anyone who knows a topic can read/write it.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=sunny-updates-CHANGE-ME-9f3a2
NTFY_INBOUND_TOPIC=sunny-inbox-CHANGE-ME-7d1b8

# --- Storage ---
# SUNNY_DB_PATH=/absolute/path/to/sunny.db

# --- Self-improvement ---
# The repo Sunny is allowed to read and (after your approval) edit, and how she
# tests a proposed change in the sandbox.
# SUNNY_REPO_ROOT=/absolute/path/to/this/sunny/checkout
# SUNNY_TEST_COMMAND=python -m pytest -q
# SUNNY_APPROVAL_TIMEOUT=300

# --- Loop ---
# SUNNY_POLL_INTERVAL=3

# --- HTTP API (so the watch app can talk to Sunny) ---
# Keep this reachable only on your LAN or a private tunnel (e.g. Tailscale).
# SUNNY_HTTP_TOKEN must match SUNNY_TOKEN in the watch app's app-side/index.js.
SUNNY_HTTP_TOKEN=change-me-long-shared-secret
# SUNNY_HTTP_HOST=0.0.0.0
# SUNNY_HTTP_PORT=8765

# --- Home Assistant (optional; real device control when both are set) ---
# HA_URL is your Home Assistant address; HA_TOKEN is a Long-Lived Access Token
# (HA -> your profile -> Security -> Long-Lived Access Tokens -> Create Token).
# Until these are set, Sunny uses simulated demo devices.
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=

# --- Daily briefing (optional) ---
# Local time "HH:MM" to push a morning briefing to your phone (serve mode).
# Leave empty to disable.
# SUNNY_BRIEFING_TIME=08:00
